
#set page(
    paper: "a4",
    margin: (x: 2cm, y: 2cm),
    header: [
        #grid(
            columns: (1fr, 1fr),
            align(left)[#text(size: 8pt, fill: rgb("#64748b"))[AUTORESTOCK-V2 ENTERPRISE PROCUREMENT SYSTEM]],
            align(right)[#text(size: 8pt, fill: rgb("#64748b"))[Official Document]]
