[Unit]
Description=AutoRestock-Agent FastAPI Service
After=network.target

[Service]
User={{USER}}
WorkingDirectory={{PWD}}
Environment="PATH={{PWD}}/.venv/bin"
ExecStart={{PWD}}/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8060 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
