[Unit]
Description=AutoRestock-Agent Dap Service (Port 8060)
After=network.target

[Service]
User={{USER}}
WorkingDirectory={{PWD}}
Environment="PATH={{PWD}}/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-{{PWD}}/.env
ExecStart={{PWD}}/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8060 --workers 1
Restart=always
RestartSec=5
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
