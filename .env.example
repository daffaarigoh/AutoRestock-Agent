# ==========================================
# AutoRestock-Agent Configuration
# ==========================================

# Application Settings
APP_NAME=AutoRestock-Agent
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8050
DEBUG=true

# Corporate LLM Gateway
LLM_URL=http://10.7.1.21/v1
LLM_KEY=your_api_key_here

# Active AI Model Configuration (Single Model: Nemotron-35)
MODEL_NAME=nemotron-35
MODEL_URL=http://localhost:8001/v1
MODEL_API_KEY=dummy-key-for-local

# Storage Paths
STORAGE_DIR=storage
DATA_DIR=data

# Email SMTP Setup (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
DEFAULT_RECIPIENT_EMAIL=manager@company.com
