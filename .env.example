# ==========================================
# AutoRestock-Agent Configuration
# ==========================================

# Application Settings
APP_NAME=AutoRestock-Agent
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Mock Mode: Set to true to test full multimodal & agent flow without running external GPU servers
MOCK_MODELS=true

# Model API Base URLs (OpenAI-compatible endpoints, Ollama, vLLM, or HuggingFace TGI)
MODEL_QWEN_URL=http://localhost:8001/v1
MODEL_NEMOTRON_URL=http://localhost:8002/v1
MODEL_OCR_LIGHTON_URL=http://localhost:8003/v1
MODEL_QWEN_VISION_URL=http://localhost:8004/v1

# API Keys (if using hosted endpoints)
MODEL_API_KEY=dummy-key-for-local

# Storage Paths
STORAGE_DIR=storage
DATA_DIR=data

# Email SMTP Setup (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
DEFAULT_RECIPIENT_EMAIL=manager@company.com

# Telegram Setup (Optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
